"
A helper node that only exists while HyCFGBuilder builds the graph, to be replaced by plain edges when the CFG is finished. It never remains in a CFG.
"
Class {
	#name : 'HyCFGTemporalNode',
	#superclass : 'HyCFGStructureNode',
	#category : 'Hyphe-CFG-Structure',
	#package : 'Hyphe-CFG',
	#tag : 'Structure'
}
